{
  "name": "pixelvault",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "dev:api": "python -m uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:api": "python -m pytest apps/api/tests",
    "ml:train": "python -m ml.scripts.train_baseline",
    "ml:train-cnn": "python -m ml.scripts.train_cnn",
    "ml:eval": "python -m ml.scripts.evaluate",
    "test": "npm run build:web"
  }
}